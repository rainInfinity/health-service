# 复制为 .env 并填写空白必填项；服务不会自动加载此模板。
# 必填：可使用 docs/development.md 中的命令生成随机密钥。
DJANGO_SECRET_KEY=
# 必填：与 Django SECRET_KEY 独立的 JWT 签名密钥，不要复用其他密钥。
JWT_SIGNING_KEY=
# 可选：Access 与 Refresh 有效期，单位正整数秒；默认分别为 7 天、30 天。
# 修改后重启签发服务，仅影响新签发令牌，不改写已有令牌的 exp。
JWT_ACCESS_TOKEN_LIFETIME_SECONDS=604800
JWT_REFRESH_TOKEN_LIFETIME_SECONDS=2592000
# 可选：本地开发启用调试；未设置时默认为 false。
DJANGO_DEBUG=true
# 必填：允许访问服务的主机名，使用逗号分隔。
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 必填：与 docs/development.md 的本地 PostgreSQL 示例一致。
POSTGRES_DB=health_service
POSTGRES_USER=health_service
# 必填：填写本地 PostgreSQL 密码。
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
# 可选：本地 PostgreSQL 示例映射端口；未设置时默认为 5432。
POSTGRES_PORT=55432

# 可选：日志文件目录；相对路径以项目根目录为基准，默认使用 logs/。
LOG_DIR=logs

# 可选：推理任务数据与模型制品目录；相对路径以项目根目录为基准。
TASK_DATA_ROOT=var/tasks
MODEL_ARTIFACT_ROOT=var/model-artifacts
# 上传文件最大字节数。
MAX_UPLOAD_BYTES=52428800
# Redis Streams 队列连接；URL 可能含凭证，不要写入日志。
REDIS_URL=redis://127.0.0.1:6379/0
INFERENCE_STREAM=health:inference
INFERENCE_GROUP=health-inference
# 执行租约与消费配置；心跳须小于租约的三分之一。
INFERENCE_LEASE_SECONDS=60
INFERENCE_HEARTBEAT_SECONDS=10
INFERENCE_DISPATCH_INTERVAL_SECONDS=30
INFERENCE_MAX_ATTEMPTS=3
INFERENCE_POLL_MILLISECONDS=1000
